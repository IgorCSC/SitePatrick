---
import { Image } from 'astro:assets';

import funilImg from '../assets/imagens/lago_vert_full_pq.jpg';
---

<head>
  <meta charset="UTF-8" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&display=swap" />
</head>

<div class="split-container">
  <div class="image-pane">
    <Image
        src={funilImg} alt="Beautiful landscape"
        class="cover-image" />
  </div>

  <div class="text-pane">
    <h1>Massa: um vertedouro acelerado do espaço no tempo</h1>
    <h2>Patrick de Vischer</h2>
    <hr class="custom-line" />
<nav class="chapter-list">
    <a href="/cap_0">
      <span class="chapter-num"></span> Introdução
    </a>
    <a href="/cap_1">
      <span class="chapter-num">1</span> Representação gráfica da evolução de acontecimentos no espaço-tempo
    </a>
    <a href="/cap_2">
      <span class="chapter-num">2</span> Representação gráfica das transformações do espaço e do tempo na relatividade restrita
    </a>
        <a href="/cap_3">
      <span class="chapter-num">3</span> Dimensões da massa e da carga elétrica
    </a>
</nav>

</div>

<style>

.chapter-list {
    display: flex;
    flex-direction: column;
    max-width: 400px;
    font-family: 'Source Sans 3', sans-serif;
  }

  .chapter-list a {
    text-decoration: none;
    color: #0d0950;       /* Navy */
    padding: 0.7rem 0;    /* Rhythm carries the separation, no lines needed */
    font-size: 1.1rem;
    transition: color 0.2s ease, transform 0.25s ease;

    /* Flex allows us to align the number and text nicely */
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* Optional: Style the numbers differently */
  .chapter-num {
    font-family: 'Newsreader', serif; /* Serif italic numeral as editorial accent */
    font-style: italic;
    color: #c0b6a4;
    font-size: 1.3em;
    font-weight: 400;
    line-height: 1;
    font-variant-numeric: tabular-nums; /* Keeps numbers aligned */
    width: 1.2rem;
    text-align: right;
    flex-shrink: 0; /* All titles start at the same x-position */
    transition: color 0.2s ease;
  }

  /* Hover Effect: gentle slide + coral accent */
  .chapter-list a:hover {
    color: #ff9776; /* Coral accent */
    transform: translateX(6px);
  }

  /* When hovering the link, the numeral warms up too */
  .chapter-list a:hover .chapter-num {
    color: #ff9776;
  }

.custom-line {
    border: 0;
    height: 2px;
    width: 3rem;
    background: #ff9776; /* Short coral editorial rule */
    margin: 2rem auto;
    margin-bottom: .8rem;
  }

h1 {
  font-family: 'Newsreader', serif;
  font-weight: 600;
  letter-spacing: -0.015em;
  color: #0d0950; /* Navy */
  margin-bottom: .5rem;
  font-size: 2.2rem;
  text-align: center;
}

h2 {
  font-family: 'Newsreader', serif;
  font-weight: 400;
  font-style: italic;
  color: #6f675b; /* Warm muted grey byline */
  margin-bottom: .5rem;
  font-size: 1.7rem;
  text-align: center;
}

  /* 1. The Container */
  .split-container {
    display: grid;
    /* This creates two columns of equal width */
    grid-template-columns: 1fr 1.6fr;
    /* Optional: Makes the container take up the full viewport height */
    min-height: 100vh; 
  }

  /* 2. The Image Pane */
  .image-pane {
    /* Ensures the image covers the entire pane without distortion */
    position: relative;
  }
  
  .image-pane img {
    width: 100%;
    height: 100%;
    object-fit: contain; /* Key property to crop image nicely */
    display: block;
    background-color: #FBF9F4;
  }

  /* 3. The Text Pane */
  .text-pane {
    font-family: "Source Sans 3", sans-serif;
    font-optical-sizing: auto;
    font-weight: 300;
    font-style: normal;
    padding: 3rem;
    display: flex;
    flex-direction: column;
    justify-content: center; /* Centers text vertically */
    background-color: #FBF9F4;
  }

  /* 4. Mobile Responsiveness */
  @media (max-width: 768px) {
    .split-container {
      /* Switches to a single column on mobile */
      grid-template-columns: 1fr;
      min-height: auto; /* Adjust height logic for mobile */
    }
    
    .image-pane {
      height: 300px; /* Give image a fixed height on mobile */
    }
  }
</style>